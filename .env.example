# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (se configura DENTRO de Supabase Auth > Providers > Google,
# pero las mismas credenciales se usan si luego llamamos la API de Calendar directo)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe — llaves de API (Developers > API keys). En modo test empiezan con
# sk_test_/pk_test_, en modo live con sk_live_/pk_live_ — son objetos
# DISTINTOS en Stripe, no basta con "activar" el modo live, hay que volver a
# generar/copiar cada uno de estos valores desde ahí.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Webhook normal (suscripciones de terapeutas a Lemy) — Developers > Webhooks
# > Add endpoint, apuntando a /api/stripe/webhook. Eventos a escuchar:
# checkout.session.completed, customer.subscription.created/updated/deleted.
STRIPE_WEBHOOK_SECRET=

# Webhook de Connect (pagos de pacientes hacia terapeutas) — es un endpoint
# APARTE en Stripe: Developers > Webhooks > Add endpoint > activar "Listen to
# events on Connected accounts", apuntando a /api/stripe/webhook-connect.
# Eventos: account.updated, checkout.session.completed. Sin esto ninguna cita
# se marca como pagada.
STRIPE_CONNECT_WEBHOOK_SECRET=

# Comisión de Lemy sobre cada cita pagada con tarjeta (Stripe Connect Direct
# charge). Opcionales — si no se definen, el código usa $5 MXN + 3% por
# default (src/lib/stripe.ts).
STRIPE_CONNECT_FEE_FIXED_MXN_CENTS=
STRIPE_CONNECT_FEE_PERCENT=

# Producto/Precio de cada plan de suscripción del terapeuta (Products > Add
# product, modo recurrente mensual) — Plan Empieza $249 MXN, Plan Gestiona
# $399 MXN.
STRIPE_PRICE_BASE=
STRIPE_PRICE_PLUS=

# Cupones (Products > Coupons > New).
# FOUNDER: 30% de descuento, duración "Multiple months" = 3, para los
# primeros 30 terapeutas fundadores (is_founding_member, automático).
STRIPE_COUPON_FOUNDER=
# REFERRAL: 30% de descuento, duración "Once" (1 factura) — se engancha a la
# suscripción de quien invitó, cuando su referido empieza a pagar de verdad.
STRIPE_COUPON_REFERRAL=
# REFERRAL_NEW_USER: 30% de descuento, duración "Multiple months" = 2 — se
# aplica en el Checkout del terapeuta nuevo que llegó por un link de referido.
STRIPE_COUPON_REFERRAL_NEW_USER=
